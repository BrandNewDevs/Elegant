{
  "name": "meeting-recorder",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Elegant: detects online calls, records, transcribes and summarises them locally.",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "build:engine": "swift build -c release --package-path ../engine",
    "build:renderer": "vite build",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build": "pnpm run build:renderer && pnpm run build:preload && tsc -p tsconfig.build.json",
    "test:engine": "swift test --package-path ../engine -Xswiftc -plugin-path -Xswiftc \"$(dirname \"$(xcrun -f swiftc)\")/../lib/swift/host/plugins/testing\"",
    "pretest": "pnpm run build:engine && pnpm run test:engine",
    "test": "vitest run",
    "start": "pnpm run build && pnpm run build:engine && env -u ELECTRON_RUN_AS_NODE electron .",
    "package": "scripts/package.sh",
    "release": "scripts/release.sh",
    "eval:baseline": "tsc -p tsconfig.build.json && node dist/evaluation/baseline-cli.js",
    "eval:ai": "tsc -p tsconfig.build.json && node dist/evaluation/cli.js",
    "eval:retrieval": "tsc -p tsconfig.build.json && node dist/evaluation/retrieval-cli.js"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
